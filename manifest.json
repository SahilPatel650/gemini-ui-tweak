{
  "manifest_version": 3,
  "name": "Gemini UI Tweak",
  "version": "1.0.0",
  "description": "Moves the Temporary Chat button from the sidebar into the main chat interface when a new chat is open in Google Gemini.",
  "permissions": [],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
